        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class User {\n    -id: int\n    -fullName: String\n    -phone: String\n    -email: String\n    +register(data)\n  }\n  class Client {\n    +getBookingHistory()\n  }\n  class Admin {\n    +manageServices()\n    +manageSchedule()\n  }\n  class Company {\n    -id: int\n    -name: String\n    -address: String\n  }\n  class Service {\n    -id: int\n    -name: String\n    -price: double\n    -duration: int\n    +findById(id)\n  }\n  class TimeSlot {\n    -id: int\n    -date: Date\n    -startTime: Time\n    -isFree: boolean\n    +getFreeSlots(serviceId, date)\n    +markBusy(slotId)\n  }\n  class Booking {\n    -id: int\n    -status: String\n    -createdAt: Date\n    +create(clientId, slotId)\n    +cancel()\n  }\n  class BookingController {\n    +selectService(serviceId)\n    +createBooking(clientId, slotId)\n    +showConfirmation(booking)\n  }\n  User &lt;|-- Client\n  User &lt;|-- Admin\n  Company \&quot;1\&quot; --&gt; \&quot;*\&quot; Service : ұсынады\n  Company \&quot;1\&quot; --&gt; \&quot;*\&quot; Admin : басқарады\n  Service \&quot;1\&quot; --&gt; \&quot;*\&quot; TimeSlot : бар\n  Client \&quot;1\&quot; --&gt; \&quot;*\&quot; Booking : жасайды\n  TimeSlot \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Booking : брондалады\n  BookingController ..&gt; Service\n  BookingController ..&gt; TimeSlot\n  BookingController ..&gt; Booking&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="kdnXiGB_C4dFuTo98XfI-64">
